<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RPGGame.UI.Avalonia"
        xmlns:effects="clr-namespace:RPGGame.UI.Avalonia.Effects"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="RPGGame.UI.Avalonia.MainWindow"
        Icon="/UI/Avalonia/Assets/df_icon.ico"
        Title="DungeonFighter v2 - ASCII Edition"
        Background="Black"
        WindowState="Minimized"
        ShowActivated="False"
        Opacity="0"
        ShowInTaskbar="False"
        Width="1920" Height="1080" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <!-- Title screen Enter / Quit: gold frame on a dark fill, brighter on hover. -->
        <Style Selector="Button.titleButton">
            <Setter Property="Background" Value="#E61A1712"/>
            <Setter Property="BorderBrush" Value="#FFC9A23C"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="#FFE8C860"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.titleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F02C2516"/>
            <Setter Property="BorderBrush" Value="#FFFFD86A"/>
            <Setter Property="Foreground" Value="#FFFFE9A0"/>
        </Style>
        <Style Selector="Button.titleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF3A2F18"/>
            <Setter Property="BorderBrush" Value="#FFFFE9A0"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
    </Window.Styles>
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Transparent Border: GameCanvasControl inherits Control (no Background), so without this wrapper pointer events miss the canvas entirely. -->
        <Border Grid.Row="0"
                x:Name="GameCanvasHitSurface"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
        <local:GameCanvasControl x:Name="GameCanvas" 
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Focusable="True"
                                FocusAdorner="{x:Null}"/>
        </Border>

        <!-- Per-cell narrative video (software-decoded; hit-test off so canvas keeps mouse). -->
        <effects:NarrativeVideoOverlayControl x:Name="NarrativeVideoOverlay"
                                            ZIndex="40"
                                            IsHitTestVisible="False"
                                            IsVisible="False"/>

        <!-- Title screen: Enter appears on the old press-key row once the intro finishes (positioned in code);
             Quit sits in the bottom-right corner for the whole title. -->
        <Button x:Name="TitleEnterButton"
                Classes="titleButton"
                ZIndex="60"
                IsVisible="False"
                Content="Enter"
                Width="260" Height="70"
                FontSize="24"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"/>
        <Button x:Name="TitleQuitButton"
                Classes="titleButton"
                ZIndex="60"
                IsVisible="False"
                Content="Quit"
                Width="216" Height="70"
                FontSize="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,6,8"/>

        <TextBlock x:Name="CombatSpeedNotificationText"
                   Grid.Row="0"
                   ZIndex="500"
                   IsVisible="False"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,10"
                   Padding="12,4"
                   Background="#D0000000"
                   Foreground="#FFFFD700"
                   FontFamily="avares://DF/UI/Avalonia/Assets/Fonts/VT323-Regular.ttf#VT323, VT323, Courier New, monospace"
                   FontSize="18"
                   FontWeight="Bold"
                   TextAlignment="Center"/>

        <!-- H hotkey help: lists play-time shortcuts without wiping the canvas. -->
        <Border x:Name="HelpOverlay"
                Grid.Row="0"
                ZIndex="1200"
                IsVisible="False"
                Background="#CC000000"
                IsHitTestVisible="True">
            <Border Background="#FF141414"
                    BorderBrush="#FF666666"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,22"
                    MaxWidth="760"
                    MaxHeight="720">
                <DockPanel>
                    <TextBlock x:Name="HelpTitleText"
                               DockPanel.Dock="Top"
                               Text="HOTKEYS"
                               FontFamily="avares://DF/UI/Avalonia/Assets/Fonts/VT323-Regular.ttf#VT323, VT323, Courier New, monospace"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FFFFD700"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="HelpFooterText"
                               DockPanel.Dock="Bottom"
                               Text="Press H or Esc to close"
                               FontFamily="avares://DF/UI/Avalonia/Assets/Fonts/VT323-Regular.ttf#VT323, VT323, Courier New, monospace"
                               FontSize="14"
                               Foreground="#FFAAAAAA"
                               Margin="0,16,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="HelpHotkeyListText"
                                   FontFamily="avares://DF/UI/Avalonia/Assets/Fonts/VT323-Regular.ttf#VT323, VT323, Courier New, monospace"
                                   FontSize="15"
                                   Foreground="#FFF0F0F0"
                                   TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
        
        <!-- TextBox for text input in action creation form -->
        <!-- Positioned where the input prompt appears on the canvas -->
        <TextBox x:Name="HiddenTextBox"
                Grid.Row="0"
                IsVisible="False"
                Width="600"
                Height="50"
                Background="Transparent"
                Foreground="Black"
                BorderThickness="0"
                BorderBrush="Transparent"
                Focusable="True"
                ZIndex="10000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0"
                FontSize="20"
                FontFamily="avares://DF/UI/Avalonia/Assets/Fonts/VT323-Regular.ttf#VT323, VT323, Courier New, monospace"
                FontWeight="Bold"
                Padding="15,10,15,10"/>
        
        <!-- Overlays stay empty at startup. SettingsPanel / TuningMenuPanel freeze Show() for
             seconds if they are in the visual tree (same reason SettingsWindow creates them late). -->
        <Border Grid.Row="0" 
                Background="#E0000000" 
                IsVisible="False"
                x:Name="TuningPanelOverlay"
                ZIndex="1000"
                IsHitTestVisible="True">
        </Border>
        
        <Border Grid.Row="0" 
                Background="#E0000000" 
                IsVisible="False"
                x:Name="SettingsPanelOverlay"
                ZIndex="1000"
                IsHitTestVisible="True">
        </Border>
    </Grid>
</Window>