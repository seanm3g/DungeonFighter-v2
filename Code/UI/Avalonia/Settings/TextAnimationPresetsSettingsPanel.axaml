<UserControl xmlns="https://github.com/avaloniaui"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"

             x:Class="RPGGame.UI.Avalonia.Settings.TextAnimationPresetsSettingsPanel"
             Classes="settings-ui"
             Background="Transparent">




    <Grid RowDefinitions="Auto,*" Margin="0">

        <!-- Pinned live preview (does not scroll with the form) -->

        <Border Grid.Row="0"

                x:Name="TextAnimationPreviewChrome"

                Background="{DynamicResource SettingsInputBackground}"

                BorderBrush="{DynamicResource SettingsInputBorder}"

                BorderThickness="0,0,0,1"

                Padding="20,16,20,12">

            <StackPanel Spacing="8">

                <TextBlock Text="Live preview" FontWeight="SemiBold" Classes="settings-field-label"/>

                <Border Background="#FF000000"

                        BorderBrush="{DynamicResource SettingsInputBorder}"

                        BorderThickness="1"

                        CornerRadius="4"

                        Padding="16"

                        MinHeight="56">

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

                        <StackPanel x:Name="PreviewCharacterHost"

                                    Orientation="Horizontal"

                                    Spacing="0"/>

                    </ScrollViewer>

                </Border>

                <TextBlock x:Name="AccentLayerStatusTextBlock"

                           FontSize="12"

                           Classes="settings-muted"

                           TextWrapping="Wrap"

                           IsVisible="False"/>

            </StackPanel>

        </Border>



        <ScrollViewer Grid.Row="1"

                      VerticalScrollBarVisibility="Auto"

                      HorizontalScrollBarVisibility="Disabled">

            <Border x:Name="TextAnimationFormSurface"

                    Background="Transparent"

                    BorderBrush="#FF404040"

                    BorderThickness="0"

                    CornerRadius="0"

                    Padding="20"

                    Margin="0">

                <StackPanel Spacing="14">

                    <TextBlock Text="Text Animation Layers"

                               FontSize="24"

                               FontWeight="Bold"

                               Classes="settings-field-label"

                               Margin="0,0,0,4"/>

                    <TextBlock FontSize="13"

                               Classes="settings-muted"

                               TextWrapping="Wrap"

                               Text="Preview layered text animations and tune preset parameters. Changes preview live; use the main Save button to write UIConfiguration.json."/>



                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset" VerticalAlignment="Center"/>

                        <ComboBox x:Name="PresetComboBox" Grid.Row="0" Grid.Column="1" MinWidth="240"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sample text" VerticalAlignment="Center" Margin="0,8,0,0"/>

                        <TextBox x:Name="SampleTextTextBox"

                                 Grid.Row="1" Grid.Column="1"

                                 Margin="0,8,0,0"

                                 Height="28"

                                 Watermark="Type sample text for the preview…"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Preview template" VerticalAlignment="Center" Margin="0,8,0,0"/>

                        <ComboBox x:Name="PreviewTemplateComboBox"

                                  Grid.Row="2" Grid.Column="1"

                                  Margin="0,8,0,0"

                                  MinWidth="240"/>

                    </Grid>



                    <TextBlock x:Name="LayerSummaryTextBlock"

                               FontFamily="Consolas, Courier New, monospace"

                               FontSize="12"

                               Classes="settings-muted"

                               TextWrapping="Wrap"/>



                    <!-- Path intro controls -->

                    <StackPanel x:Name="PathIntroControls" Spacing="8" IsVisible="False">

                        <TextBlock Text="Color overlay (path intro)" FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="140,*,40" RowDefinitions="Auto,Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Gradient start" VerticalAlignment="Center"/>

                            <TextBox x:Name="GradientStartTextBox" Grid.Row="0" Grid.Column="1" Height="28" Margin="0,0,8,6" Watermark="#FFF4DC"/>

                            <Border x:Name="GradientStartPreview" Grid.Row="0" Grid.Column="2" Width="32" Height="28" BorderBrush="#FF888888" BorderThickness="1" Margin="0,0,0,6" ToolTip.Tip="Gradient start color"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Gradient end" VerticalAlignment="Center"/>

                            <TextBox x:Name="GradientEndTextBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,8,6" Watermark="#E2F1FF"/>

                            <Border x:Name="GradientEndPreview" Grid.Row="1" Grid.Column="2" Width="32" Height="28" BorderBrush="#FF888888" BorderThickness="1" Margin="0,0,0,6" ToolTip.Tip="Gradient end color"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Phase speed (ms)" VerticalAlignment="Center"/>

                            <TextBox x:Name="PhaseDivisorMsTextBox" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,8,6" Watermark="320"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Char phase offset" VerticalAlignment="Center"/>

                            <TextBox x:Name="CharacterPhaseOffsetTextBox" Grid.Row="3" Grid.Column="1" Height="28" Margin="0,0,8,0" Watermark="0.36"/>

                        </Grid>

                    </StackPanel>



                    <!-- HSV shimmer controls -->

                    <StackPanel x:Name="HsvControls" Spacing="8" IsVisible="False">

                        <TextBlock Text="HSV shimmer layers" FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="160,*,80" RowDefinitions="Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Undulation amplitude" VerticalAlignment="Center"/>

                            <Slider x:Name="HsvAmplitudeSlider" Grid.Row="0" Grid.Column="1"

                                    Minimum="0.5" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,8,8"/>

                            <TextBox x:Name="HsvAmplitudeTextBox" Grid.Row="0" Grid.Column="2" Height="28" Margin="0,0,0,8" Watermark="3.0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Clamp min (0–255)" VerticalAlignment="Center"/>

                            <TextBox x:Name="ClampMinTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="28" Margin="0,0,0,8" Watermark="150"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Clamp max (0–255)" VerticalAlignment="Center"/>

                            <TextBox x:Name="ClampMaxTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="28" Watermark="255"/>

                        </Grid>

                    </StackPanel>



                    <!-- Optional accent HSV layer (stacked on top) -->

                    <StackPanel x:Name="AccentHsvControls" Spacing="8" Margin="0,4,0,0">

                        <TextBlock Text="Accent HSV layer (optional stack on top)" FontWeight="SemiBold"/>

                        <TextBlock FontSize="12" Classes="settings-muted" TextWrapping="Wrap"

                                   Text="Adds or updates a top hsvAdjust layer masked by a sine wave. Hue 0° and saturation 1.0× remove the accent layer. Sliders and text boxes stay in sync when you press Enter or leave the field. Phase and char offset update the preview live while typing. Saturation scale range is 0–1.5×."/>

                        <Grid ColumnDefinitions="160,*,80,40" RowDefinitions="Auto,Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hue shift (°)" VerticalAlignment="Center"/>

                            <Slider x:Name="AccentHueShiftSlider" Grid.Row="0" Grid.Column="1"

                                    Minimum="-180" Maximum="180" TickFrequency="5" Margin="0,0,8,8"/>

                            <TextBox x:Name="AccentHueShiftTextBox" Grid.Row="0" Grid.Column="2" Height="28" Margin="0,0,8,8" Watermark="0"/>

                            <Border x:Name="AccentHuePreview" Grid.Row="0" Grid.Column="3" Width="32" Height="28"

                                    Background="#FFFFB454" BorderBrush="#FF888888" BorderThickness="1" Margin="0,0,0,8"

                                    ToolTip.Tip="Sample with current hue shift (full mask)"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Saturation scale" VerticalAlignment="Center"/>

                            <Slider x:Name="AccentSaturationSlider" Grid.Row="1" Grid.Column="1"

                                    Minimum="0" Maximum="1.5" TickFrequency="0.1" Margin="0,0,8,8"/>

                            <TextBox x:Name="AccentSaturationTextBox" Grid.Row="1" Grid.Column="2" Height="28" Margin="0,0,8,8" Watermark="1.00"/>

                            <Border x:Name="AccentSaturationPreview" Grid.Row="1" Grid.Column="3" Width="32" Height="28"

                                    Background="#FFFFB454" BorderBrush="#FF888888" BorderThickness="1" Margin="0,0,0,8"

                                    ToolTip.Tip="Sample with current saturation scale (full mask)"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Accent phase (ms)" VerticalAlignment="Center"/>

                            <TextBox x:Name="AccentPhaseDivisorMsTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="28" Margin="0,0,0,8" Watermark="500"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Accent char offset" VerticalAlignment="Center"/>

                            <TextBox x:Name="AccentCharacterPhaseOffsetTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="28" Watermark="0.20"/>

                        </Grid>

                    </StackPanel>



                    <Border Height="1" Background="#FFE0E0E0" Margin="0,8,0,8"/>



                    <!-- Global animation timing -->

                    <TextBlock Text="Global animation timing" FontWeight="SemiBold"/>

                    <TextBlock FontSize="12" Foreground="#FF666666" TextWrapping="Wrap"

                               Text="Shared clock for undulation and brightness mask (dungeonSelectionAnimation in UIConfiguration.json)."/>

                    <CheckBox x:Name="BrightnessMaskEnabledCheckBox" Content="Brightness mask enabled" Margin="0,4,0,0"/>

                    <Grid ColumnDefinitions="180,*,80" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mask intensity" VerticalAlignment="Center"/>

                        <Slider x:Name="BrightnessMaskIntensitySlider" Grid.Row="0" Grid.Column="1"

                                Minimum="0" Maximum="100" TickFrequency="1" Margin="0,0,8,6"/>

                        <TextBox x:Name="BrightnessMaskIntensityTextBox" Grid.Row="0" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mask wave length" VerticalAlignment="Center"/>

                        <Slider x:Name="BrightnessMaskWaveLengthSlider" Grid.Row="1" Grid.Column="1"

                                Minimum="1" Maximum="20" TickFrequency="0.5" Margin="0,0,8,6"/>

                        <TextBox x:Name="BrightnessMaskWaveLengthTextBox" Grid.Row="1" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Mask update (ms)" VerticalAlignment="Center"/>

                        <TextBox x:Name="BrightnessMaskUpdateIntervalTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="28" Margin="0,0,0,6" Watermark="100"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Undulation speed" VerticalAlignment="Center"/>

                        <Slider x:Name="UndulationSpeedSlider" Grid.Row="3" Grid.Column="1"

                                Minimum="-0.2" Maximum="0.2" TickFrequency="0.005" Margin="0,0,8,6"/>

                        <TextBox x:Name="UndulationSpeedTextBox" Grid.Row="3" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="-0.050"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Undulation wave length" VerticalAlignment="Center"/>

                        <Slider x:Name="UndulationWaveLengthSlider" Grid.Row="4" Grid.Column="1"

                                Minimum="1" Maximum="20" TickFrequency="0.5" Margin="0,0,8,6"/>

                        <TextBox x:Name="UndulationWaveLengthTextBox" Grid.Row="4" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Undulation interval (ms)" VerticalAlignment="Center"/>

                        <TextBox x:Name="UndulationIntervalTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Height="28" Margin="0,0,0,6" Watermark="50"/>

                    </Grid>

                    <Border Height="1" Background="#FFE0E0E0" Margin="0,12,0,8"/>

                    <TextBlock Text="Mouse wind wake" FontWeight="SemiBold"/>
                    <TextBlock FontSize="12" Foreground="#FF666666" TextWrapping="Wrap"
                               Text="One circle around the pointer with near→far falloff; stronger behind motion than in front. Optional red/cyan chromatic fringe on swayed glyphs. F6 still toggles the effect at runtime. Save to persist; sliders apply live to the main canvas."/>
                    <CheckBox x:Name="WindSwayEnabledCheckBox" Content="Wind wake enabled" Margin="0,4,0,0"/>
                    <CheckBox x:Name="WindSwayChromaticEnabledCheckBox" Content="Chromatic aberration" Margin="0,4,0,0"
                              ToolTip.Tip="Red/cyan fringe on swayed glyphs; scales with wake strength."/>
                    <Grid ColumnDefinitions="180,*,80" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Wake radius (cells)" VerticalAlignment="Center"/>
                        <Slider x:Name="WindSwayRadiusSlider" Grid.Row="0" Grid.Column="1"
                                Minimum="8" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,8,6"/>
                        <TextBox x:Name="WindSwayRadiusTextBox" Grid.Row="0" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="36"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Near influence" VerticalAlignment="Center"/>
                        <Slider x:Name="WindSwayNearInfluenceSlider" Grid.Row="1" Grid.Column="1"
                                Minimum="0" Maximum="1.5" TickFrequency="0.05" Margin="0,0,8,6"/>
                        <TextBox x:Name="WindSwayNearInfluenceTextBox" Grid.Row="1" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="1.0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Far influence" VerticalAlignment="Center"/>
                        <Slider x:Name="WindSwayFarInfluenceSlider" Grid.Row="2" Grid.Column="1"
                                Minimum="0" Maximum="1" TickFrequency="0.05" Margin="0,0,8,6"/>
                        <TextBox x:Name="WindSwayFarInfluenceTextBox" Grid.Row="2" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="0.35"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Rear bias" VerticalAlignment="Center"/>
                        <Slider x:Name="WindSwayRearBiasSlider" Grid.Row="3" Grid.Column="1"
                                Minimum="0" Maximum="1" TickFrequency="0.05" Margin="0,0,8,6"/>
                        <TextBox x:Name="WindSwayRearBiasTextBox" Grid.Row="3" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="0.65"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="CA spread" VerticalAlignment="Center"/>
                        <Slider x:Name="WindSwayChromaticSpreadSlider" Grid.Row="4" Grid.Column="1"
                                Minimum="0" Maximum="0.4" TickFrequency="0.01" Margin="0,0,8,6"/>
                        <TextBox x:Name="WindSwayChromaticSpreadTextBox" Grid.Row="4" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="0.10"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="CA opacity" VerticalAlignment="Center"/>
                        <Slider x:Name="WindSwayChromaticOpacitySlider" Grid.Row="5" Grid.Column="1"
                                Minimum="0" Maximum="1" TickFrequency="0.05" Margin="0,0,8,6"/>
                        <TextBox x:Name="WindSwayChromaticOpacityTextBox" Grid.Row="5" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="0.35"/>
                    </Grid>
                    <Button x:Name="WindSwayDebugRadiusButton" Content="Show wake radius on canvas" Margin="0,8,0,0" Padding="12,6"
                            HorizontalAlignment="Left"
                            ToolTip.Tip="Draws the current wake circle around the mouse on the main game canvas (debug; not saved)."/>

                    <Border Height="1" Background="#FFE0E0E0" Margin="0,12,0,8"/>

                    <TextBlock Text="Click-charge explosion" FontWeight="SemiBold"/>
                    <TextBlock FontSize="12" Foreground="#FF666666" TextWrapping="Wrap"
                               Text="Spam left-click to charge, then glyphs explode outward and stay scattered until you click them back. Radius is the disturbance/explode reach in character cells. Variance and spin often matter more than strength for how chaotic it feels. F6 still toggles with wind. Save to persist; sliders apply live."/>
                    <CheckBox x:Name="ClickBurstEnabledCheckBox" Content="Click-charge explosion enabled" Margin="0,4,0,0"/>
                    <Grid ColumnDefinitions="180,*,80"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          Margin="0,4,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Radius (cells)" VerticalAlignment="Center"
                                   ToolTip.Tip="Impulse / explode reach in character cells (impulseRadiusCells)."/>
                        <Slider x:Name="ClickBurstRadiusSlider" Grid.Row="0" Grid.Column="1"
                                Minimum="2" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstRadiusTextBox" Grid.Row="0" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="12"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Explode strength" VerticalAlignment="Center"
                                   ToolTip.Tip="Peak scatter distance in character cells before per-glyph variance (explodeMaxOffsetFraction)."/>
                        <Slider x:Name="ClickBurstExplodeStrengthSlider" Grid.Row="1" Grid.Column="1"
                                Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstExplodeStrengthTextBox" Grid.Row="1" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Explode out (sec)" VerticalAlignment="Center"
                                   ToolTip.Tip="Seconds for glyphs to push outward (explodeOutSeconds)."/>
                        <Slider x:Name="ClickBurstExplodeOutSlider" Grid.Row="2" Grid.Column="1"
                                Minimum="0.05" Maximum="1.5" TickFrequency="0.01" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstExplodeOutTextBox" Grid.Row="2" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="0.28"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Clicks to explode" VerticalAlignment="Center"
                                   ToolTip.Tip="Clicks needed to fill charge and trigger explode (clicksToExplode)."/>
                        <Slider x:Name="ClickBurstClicksToExplodeSlider" Grid.Row="3" Grid.Column="1"
                                Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstClicksToExplodeTextBox" Grid.Row="3" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="5"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Distance variance min" VerticalAlignment="Center"
                                   ToolTip.Tip="Minimum per-glyph distance multiplier during explode (distanceVarianceMin)."/>
                        <Slider x:Name="ClickBurstDistanceVarianceMinSlider" Grid.Row="4" Grid.Column="1"
                                Minimum="0" Maximum="4" TickFrequency="0.05" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstDistanceVarianceMinTextBox" Grid.Row="4" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="0.2"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Distance variance max" VerticalAlignment="Center"
                                   ToolTip.Tip="Maximum per-glyph distance multiplier during explode (distanceVarianceMax)."/>
                        <Slider x:Name="ClickBurstDistanceVarianceMaxSlider" Grid.Row="5" Grid.Column="1"
                                Minimum="0" Maximum="4" TickFrequency="0.05" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstDistanceVarianceMaxTextBox" Grid.Row="5" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="1.45"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Max rotation (rad)" VerticalAlignment="Center"
                                   ToolTip.Tip="Peak random glyph spin in radians (±value; maxRotationRadians). ~6.3 ≈ one full turn."/>
                        <Slider x:Name="ClickBurstMaxRotationSlider" Grid.Row="6" Grid.Column="1"
                                Minimum="0" Maximum="12.5" TickFrequency="0.1" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstMaxRotationTextBox" Grid.Row="6" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="7.5"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Vertical scale" VerticalAlignment="Center"
                                   ToolTip.Tip="Vertical offset scale relative to horizontal (verticalScale)."/>
                        <Slider x:Name="ClickBurstVerticalScaleSlider" Grid.Row="7" Grid.Column="1"
                                Minimum="0.1" Maximum="2" TickFrequency="0.05" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstVerticalScaleTextBox" Grid.Row="7" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="0.85"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Chromatic velocity (sec)" VerticalAlignment="Center"
                                   ToolTip.Tip="Converts flight velocity into chromatic fringe (chromaticVelocitySeconds). Landed letters stay clean."/>
                        <Slider x:Name="ClickBurstChromaticVelocitySlider" Grid.Row="8" Grid.Column="1"
                                Minimum="0" Maximum="0.5" TickFrequency="0.01" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstChromaticVelocityTextBox" Grid.Row="8" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="0.12"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Charge decay /sec" VerticalAlignment="Center"
                                   ToolTip.Tip="Charge lost per second while idle, not exploding (chargeDecayPerSecond)."/>
                        <Slider x:Name="ClickBurstChargeDecaySlider" Grid.Row="9" Grid.Column="1"
                                Minimum="0" Maximum="2" TickFrequency="0.05" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstChargeDecayTextBox" Grid.Row="9" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="0.55"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Impulse decay /sec" VerticalAlignment="Center"
                                   ToolTip.Tip="How fast the post-click ripple amplitude decays (impulseDecayPerSecond)."/>
                        <Slider x:Name="ClickBurstImpulseDecaySlider" Grid.Row="10" Grid.Column="1"
                                Minimum="0" Maximum="10" TickFrequency="0.1" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstImpulseDecayTextBox" Grid.Row="10" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="2.5"/>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Auto-rebuild idle (sec)" VerticalAlignment="Center"
                                   ToolTip.Tip="Seconds with no hole click after scatter lands before autofill starts (autoRebuildIdleSeconds)."/>
                        <Slider x:Name="ClickBurstAutoRebuildIdleSlider" Grid.Row="11" Grid.Column="1"
                                Minimum="0" Maximum="60" TickFrequency="0.5" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstAutoRebuildIdleTextBox" Grid.Row="11" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="10"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Auto-rebuild interval (sec)" VerticalAlignment="Center"
                                   ToolTip.Tip="Seconds between auto-filled letters once idle autofill is running (autoRebuildIntervalSeconds)."/>
                        <Slider x:Name="ClickBurstAutoRebuildIntervalSlider" Grid.Row="12" Grid.Column="1"
                                Minimum="0.05" Maximum="2" TickFrequency="0.05" Margin="0,0,8,6"/>
                        <TextBox x:Name="ClickBurstAutoRebuildIntervalTextBox" Grid.Row="12" Grid.Column="2" Height="28" Margin="0,0,0,6" Watermark="0.5"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">

                        <Button x:Name="ResetPresetButton" Content="Reset preset to defaults" Padding="12,6"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</UserControl>

