<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:RPGGame.UI.Avalonia.Settings"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="960"
             x:Class="RPGGame.UI.Avalonia.Settings.ItemGenerationSettingsPanel" Classes="settings-ui" Background="#FF1E1E1E">
    <Grid Margin="12" ColumnDefinitions="248,*" MinHeight="560">
        <!-- Left: generation parameters -->
        <Border Grid.Column="0"
                Background="#FF252526"
                BorderBrush="#FF3F3F46"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,12,12,10">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Generation parameters"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Item type" FontSize="11" FontWeight="SemiBold" Classes="settings-muted"/>
                            <ComboBox x:Name="ItemTypeCombo" Classes="ParamCombo" MinHeight="32" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Weapon type" FontSize="11" FontWeight="SemiBold" Classes="settings-muted"/>
                            <ComboBox x:Name="WeaponTypeCombo" Classes="ParamCombo" MinHeight="32" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Armor slot" FontSize="11" FontWeight="SemiBold" Classes="settings-muted"/>
                            <ComboBox x:Name="ArmorSlotCombo" Classes="ParamCombo" MinHeight="32" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Rarity" FontSize="11" FontWeight="SemiBold" Classes="settings-muted"/>
                            <ComboBox x:Name="RarityCombo" Classes="ParamCombo" MinHeight="32" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Tier" FontSize="11" FontWeight="SemiBold" Classes="settings-muted"/>
                            <ComboBox x:Name="TierCombo" Classes="ParamCombo" MinHeight="32" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Hero level" FontSize="11" FontWeight="SemiBold" Classes="settings-muted"
                                       ToolTip.Tip="When Rarity is Any, rarity rolls use this level (Epic+ gates)."/>
                            <TextBox x:Name="HeroLevelTextBox" Classes="ParamField" Text="1" MinHeight="32" HorizontalAlignment="Stretch" MaxLength="3"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Dungeon Δ" FontSize="11" FontWeight="SemiBold" Classes="settings-muted"
                                       ToolTip.Tip="Relative to hero: effective dungeon = hero + Δ (clamped 1–99). When Tier is Any, tier rolls use hero vs effective dungeon (LootTierCalculator / TierDistribution.json), same as LootGenerator."/>
                            <TextBox x:Name="DungeonDeltaTextBox" Classes="ParamField" Text="+0" MinHeight="32" HorizontalAlignment="Stretch" MaxLength="4"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Count" FontSize="11" FontWeight="SemiBold" Classes="settings-muted"/>
                            <TextBox x:Name="CountTextBox" Classes="ParamField" Text="100" MinHeight="32" HorizontalAlignment="Stretch" MaxLength="9"
                                     ToolTip.Tip="Batch size (1–1,000,000). Large batches can be slow."/>
                        </StackPanel>

                        <Border Background="#FF1E1E1E" BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="8,6">
                            <TextBlock x:Name="HeroLevelRarityPreviewText"
                                       FontSize="11"
                                       Foreground="#FFBBBBBB"
                                       LineHeight="15"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Spacing="10" Margin="0,14,0,0">
                    <Button x:Name="ClearButton" Content="Clear" Height="34" HorizontalAlignment="Stretch"
                            BorderThickness="0" CornerRadius="3" FontSize="12" Cursor="Hand"/>
                    <Button x:Name="GenerateButton" Content="Generate" Height="36" HorizontalAlignment="Stretch"
                            BorderThickness="0" CornerRadius="3" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right: configuration (top) + results (bottom) -->
        <Grid Grid.Column="1" Margin="14,0,0,0" RowDefinitions="2*,3*" MinHeight="520">
            <!-- Top: affix table + lab / tier -->
            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,16,340">
                    <!-- Affix column is width-constrained (no horizontal scroll) so * grid columns share the pane; lab + tier stay in fixed right column. -->
                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  MinWidth="0">
                        <Border Background="#FF252526"
                                BorderBrush="#FF3F3F46"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Real loot — this lab"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock FontSize="11"
                                           Foreground="#FFCCCCCC"
                                           TextWrapping="Wrap"
                                           LineHeight="15"
                                           Text="Batches here use the same item roller as dungeon loot: item level, slot and class, tier, base, rarity, material, then lines. Rarity sets how many lines (RarityTable.json: per-pool min/max, MaxLines, Explode chance per extra line). Mod families and their tiers (keyword, value range, item level, weight, rarity gate) live in ItemMods.json; regenerate with Scripts/build-item-mods.py. Roll-ups, class / material shares and influence are under lootSystem.itemGeneration in the balance patch."/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="Combo max (base)" VerticalAlignment="Center" Classes="settings-muted" FontSize="10"/>
                                    <TextBox x:Name="ComboSeqBaseMaxText" Width="44" Classes="ParamField" MaxLength="2"
                                             ToolTip.Tip="LootSystemConfig.ComboSequenceBaseMax → JSON lootSystem.comboSequenceBaseMax. Starting combo length before gear ExtraActionSlots, named class-tier upgrades, and Wand intrinsic slot bonus; must be ≤ hard cap."/>
                                    <TextBlock Text="hard cap" VerticalAlignment="Center" Classes="settings-muted" FontSize="10"/>
                                    <TextBox x:Name="ComboSeqAbsMaxText" Width="44" Classes="ParamField" MaxLength="2"
                                             ToolTip.Tip="LootSystemConfig.ComboSequenceAbsoluteMax → JSON lootSystem.comboSequenceAbsoluteMax. Hard ceiling. Effective max = min(this, base + equipped ExtraActionSlots + named class-tier upgrades + Wand intrinsic bonus)."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <StackPanel Grid.Column="2"
                                Spacing="12"
                                HorizontalAlignment="Stretch">
                        <Border Background="#FF252526"
                                BorderBrush="#FF3F3F46"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Lab rarity chances (fixed, ignores level)"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="Base ratio"
                                               FontSize="11"
                                               Classes="settings-muted"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="Geometric odds: Common is X× more common than Uncommon; Uncommon is X× more common than Rare; ... Legendary is X× more common than Mythic. Leave blank to manually edit the % boxes below."/>
                                    <TextBox Grid.Column="1"
                                             x:Name="BaseRatioTextBox"
                                             Classes="LabPctBox"
                                             Text="8"
                                             MinHeight="26"
                                             Width="64"
                                             Margin="8,0,0,0"
                                             HorizontalContentAlignment="Center"
                                             TextAlignment="Center"
                                             BorderThickness="1"
                                             MaxLength="6"/>
                                    <Panel Grid.Column="2"/>
                                </Grid>
                                <Border Background="#FF1E1E1E"
                                        BorderBrush="#FF3F3F46"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,4">
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,4,4" MinWidth="56">
                                            <TextBlock Text="Common" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="4,2" MinHeight="26" MinWidth="56">
                                                <TextBox x:Name="FixedChanceCommon" Classes="LabPctBox" Text="87.87" MinHeight="22" HorizontalContentAlignment="Center" TextAlignment="Center" BorderThickness="0" MaxLength="6"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,4,4" MinWidth="56">
                                            <TextBlock Text="Uncommon" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="4,2" MinHeight="26" MinWidth="56">
                                                <TextBox x:Name="FixedChanceUncommon" Classes="LabPctBox" Text="8.79" MinHeight="22" HorizontalContentAlignment="Center" TextAlignment="Center" BorderThickness="0" MaxLength="6"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,4,4" MinWidth="56">
                                            <TextBlock Text="Rare" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="4,2" MinHeight="26" MinWidth="56">
                                                <TextBox x:Name="FixedChanceRare" Classes="LabPctBox" Text="2.64" MinHeight="22" HorizontalContentAlignment="Center" TextAlignment="Center" BorderThickness="0" MaxLength="6"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,4,4" MinWidth="56">
                                            <TextBlock Text="Epic" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="4,2" MinHeight="26" MinWidth="56">
                                                <TextBox x:Name="FixedChanceEpic" Classes="LabPctBox" Text="0.53" MinHeight="22" HorizontalContentAlignment="Center" TextAlignment="Center" BorderThickness="0" MaxLength="6"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,4,4" MinWidth="56">
                                            <TextBlock Text="Legendary" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="4,2" MinHeight="26" MinWidth="56">
                                                <TextBox x:Name="FixedChanceLegendary" Classes="LabPctBox" Text="0.18" MinHeight="22" HorizontalContentAlignment="Center" TextAlignment="Center" BorderThickness="0" MaxLength="6"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,0,4" MinWidth="56">
                                            <TextBlock Text="Mythic" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="4,2" MinHeight="26" MinWidth="56">
                                                <TextBox x:Name="FixedChanceMythic" Classes="LabPctBox" Text="0.02" MinHeight="22" HorizontalContentAlignment="Center" TextAlignment="Center" BorderThickness="0" MaxLength="6"/>
                                            </Border>
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>
                                <TextBlock x:Name="FixedChanceSummaryText"
                                           FontSize="10"
                                           Classes="settings-muted"
                                           TextWrapping="Wrap"
                                           LineHeight="13"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FF252526"
                                BorderBrush="#FF3F3F46"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="TierTableTitleText"
                                           Text="Live loot tier chances"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock x:Name="TierTableSubtitleText"
                                           FontSize="10"
                                           Classes="settings-muted"
                                           TextWrapping="Wrap"
                                           LineHeight="13"/>
                                <Border Background="#FF1E1E1E"
                                        BorderBrush="#FF3F3F46"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,4">
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,4,4" MinWidth="64">
                                            <TextBlock Text="T1" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4" MinHeight="28" MinWidth="64">
                                                <TextBlock x:Name="TierPct1Text" FontSize="14" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,4,4" MinWidth="64">
                                            <TextBlock Text="T2" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4" MinHeight="28" MinWidth="64">
                                                <TextBlock x:Name="TierPct2Text" FontSize="14" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,4,4" MinWidth="64">
                                            <TextBlock Text="T3" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4" MinHeight="28" MinWidth="64">
                                                <TextBlock x:Name="TierPct3Text" FontSize="14" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,4,4" MinWidth="64">
                                            <TextBlock Text="T4" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4" MinHeight="28" MinWidth="64">
                                                <TextBlock x:Name="TierPct4Text" FontSize="14" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="0,0,0,4" MinWidth="64">
                                            <TextBlock Text="T5" FontSize="10" Classes="settings-muted" HorizontalAlignment="Center"/>
                                            <Border BorderBrush="#FF3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,4" MinHeight="28" MinWidth="64">
                                                <TextBlock x:Name="TierPct5Text" FontSize="14" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>
                                <TextBlock x:Name="TierTableNoteText"
                                           FontSize="10"
                                           Classes="settings-muted"
                                           TextWrapping="Wrap"
                                           LineHeight="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Bottom: results -->
            <Grid Grid.Row="1" RowDefinitions="Auto,*" MinHeight="160">
                <TextBlock Grid.Row="0"
                           Text="RESULTS:"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <Grid x:Name="ResultsSplitGrid"
                      Grid.Row="1"
                      ColumnDefinitions="2*,22,10,1*"
                      VerticalAlignment="Stretch">
                    <Border x:Name="GeneratedItemsHost"
                            Grid.Column="0"
                            Background="#FF252526"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0"
                                       Text="Generated items (best → worst)"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <Border Grid.Row="1"
                                    Background="#FF1A1A1A"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,0,0,8">
                                <Grid ColumnDefinitions="36,84,44,*,88,76,76">
                                    <TextBlock Grid.Column="0" Text="#" Foreground="#FFCCCCCC" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Rarity" Foreground="#FFCCCCCC" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="T" Foreground="#FFCCCCCC" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Name" Foreground="#FFCCCCCC" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Dmg/Arm" Foreground="#FFCCCCCC" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="Speed" Foreground="#FFCCCCCC" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="Affixes" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2"
                                     x:Name="ItemsListBox"
                                     SelectionMode="Single"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.IsScrollChainingEnabled="False">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="settings:ItemGeneratedRowViewModel">
                                        <Border CornerRadius="4"
                                                Padding="8"
                                                Margin="0,1">
                                            <Grid ColumnDefinitions="36,84,44,*,88,76,76">
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Rarity}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Tier}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding PrimaryStat}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding SpeedText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding AffixesText}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Button x:Name="ToggleGeneratedListButton"
                            Grid.Column="1"
                            MinWidth="22"
                            Width="22"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            BorderThickness="0"
                            CornerRadius="0"
                            FontSize="18"
                            FontWeight="Bold"
                            Padding="0"
                            Cursor="Hand"
                            Content="‹"
                            ToolTip.Tip="Hide the generated item list (less UI work for very large batches). Statistics stay visible. Click again to show the list."/>

                    <Border Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#FF252526"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Selected item"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <Border BorderBrush="#FF3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Statistics"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FFDDDDDD"/>
                                    <TextBlock x:Name="BatchStatsText"
                                               Text="(no generated items)"
                                               FontSize="12"
                                               Foreground="#FFCCCCCC"
                                               TextWrapping="Wrap"
                                               LineHeight="16"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="SelectedNameText"
                                       Text="(none)"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedStatsText"
                                       Text=""
                                       FontSize="13"
                                       Foreground="#FFCCCCCC"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
