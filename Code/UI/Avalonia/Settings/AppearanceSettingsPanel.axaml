<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:RPGGame.UI.Avalonia.Settings"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="RPGGame.UI.Avalonia.Settings.AppearanceSettingsPanel" Classes="settings-ui" Background="Transparent">
    <TabControl x:Name="AppearanceTabControl">
        <TabItem Header="Settings UI">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="20">
                    <TextBlock Text="Colors for the settings window chrome (sidebar, title, buttons, and inputs)."
                               Classes="settings-muted"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                        <!-- Panel Colors -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Panel Colors" 
                                       FontSize="17" 
                                       FontWeight="SemiBold" 
                                       Classes="settings-field-label" 
                                       Margin="0,0,0,6"/>
                            <UniformGrid Columns="3" Rows="1">
                                <!-- Panel Background -->
                                <StackPanel Spacing="5" Margin="0,0,12,0">
                                    <TextBlock Text="Panel Background:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PanelBackgroundTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FFFFFFFF"/>
                                        <Border x:Name="PanelBackgroundPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="White"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Panel Border -->
                                <StackPanel Spacing="5" Margin="0,0,12,0">
                                    <TextBlock Text="Panel Border:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PanelBorderTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF404040"/>
                                        <Border x:Name="PanelBorderPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="Transparent"
                                                BorderBrush="#FF404040"
                                                BorderThickness="2"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Panel Text -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Panel Text:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PanelTextTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF000000"/>
                                        <Border x:Name="PanelTextPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="Black"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Aa" 
                                                       Classes="settings-field-label"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        
                        <!-- Divider -->
                        <Border Height="1" Background="#FFE0E0E0" Margin="0,8,0,8"/>
                        
                        <!-- Settings Window Colors -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Settings Window Colors" 
                                       FontSize="17" 
                                       FontWeight="SemiBold" 
                                       Classes="settings-field-label" 
                                       Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Rows="1">
                                <!-- Window Background -->
                                <StackPanel Spacing="5" Margin="0,0,12,0">
                                    <TextBlock Text="Window Background:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SettingsBackgroundTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF1A1A1A"/>
                                        <Border x:Name="SettingsBackgroundPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="#FF1A1A1A"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Title Color -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Title Color:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SettingsTitleTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FFD700"/>
                                        <Border x:Name="SettingsTitlePreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Title" 
                                                       Foreground="#FFD700"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        
                        <!-- Divider -->
                        <Border Height="1" Background="#FFE0E0E0" Margin="0,8,0,8"/>
                        
                        <!-- Navigation List Colors -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Navigation List Colors" 
                                       FontSize="17" 
                                       FontWeight="SemiBold" 
                                       Classes="settings-field-label" 
                                       Margin="0,0,0,6"/>
                            <UniformGrid Columns="3" Rows="1">
                                <!-- Selected Text -->
                                <StackPanel Spacing="5" Margin="0,0,12,0">
                                    <TextBlock Text="Selected Text:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ListBoxSelectedTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FFD700"/>
                                        <Border x:Name="ListBoxSelectedPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Selected" 
                                                       Foreground="#FFD700"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Selected Background -->
                                <StackPanel Spacing="5" Margin="0,0,12,0">
                                    <TextBlock Text="Selected Background:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ListBoxSelectedBackgroundTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF2A2A2A"/>
                                        <Border x:Name="ListBoxSelectedBackgroundPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Hover Background -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Hover Background:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ListBoxHoverBackgroundTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF353535"/>
                                        <Border x:Name="ListBoxHoverBackgroundPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="#FF353535"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        
                        <!-- Divider -->
                        <Border Height="1" Background="#FFE0E0E0" Margin="0,8,0,8"/>
                        
                        <!-- Text Input Colors -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Text Input Colors" 
                                       FontSize="17" 
                                       FontWeight="SemiBold" 
                                       Classes="settings-field-label" 
                                       Margin="0,0,0,6"/>
                            <UniformGrid Columns="3" Rows="2">
                                <!-- Text Color -->
                                <StackPanel Spacing="5" Margin="0,0,12,10">
                                    <TextBlock Text="Text Color:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TextBoxTextColorTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 SelectionBrush="#FF0078D4"
                                                 SelectionForegroundBrush="White"
                                                 Text="#FFFFFF"/>
                                        <Border x:Name="TextBoxTextColorPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Aa" 
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Background -->
                                <StackPanel Spacing="5" Margin="0,0,12,10">
                                    <TextBlock Text="Background:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TextBoxBackgroundTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF2A2A2A"/>
                                        <Border x:Name="TextBoxBackgroundPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Hover Background -->
                                <StackPanel Spacing="5" Margin="0,0,0,10">
                                    <TextBlock Text="Hover Background:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TextBoxHoverBackgroundTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF353535"/>
                                        <Border x:Name="TextBoxHoverBackgroundPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="#FF353535"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Border Color -->
                                <StackPanel Spacing="5" Margin="0,0,12,0">
                                    <TextBlock Text="Border Color:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TextBoxBorderTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF555555"/>
                                        <Border x:Name="TextBoxBorderPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="Transparent"
                                                BorderThickness="2"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Focus Border -->
                                <StackPanel Spacing="5" Margin="0,0,12,0">
                                    <TextBlock Text="Focus Border:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TextBoxFocusBorderTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF0078D4"/>
                                        <Border x:Name="TextBoxFocusBorderPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="Transparent"
                                                BorderBrush="#FF0078D4"
                                                BorderThickness="2"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Empty cell for alignment -->
                                <StackPanel Spacing="5"/>
                            </UniformGrid>
                        </StackPanel>
                        
                        <!-- Divider -->
                        <Border Height="1" Background="#FFE0E0E0" Margin="0,8,0,8"/>
                        
                        <!-- Button Colors -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Button Colors" 
                                       FontSize="17" 
                                       FontWeight="SemiBold" 
                                       Classes="settings-field-label" 
                                       Margin="0,0,0,6"/>
                            <UniformGrid Columns="3" Rows="1">
                                <!-- Primary Button -->
                                <StackPanel Spacing="5" Margin="0,0,12,0">
                                    <TextBlock Text="Primary Button:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ButtonPrimaryTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF0078D4"/>
                                        <Border x:Name="ButtonPrimaryPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="#FF0078D4"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Secondary Button -->
                                <StackPanel Spacing="5" Margin="0,0,12,0">
                                    <TextBlock Text="Secondary Button:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ButtonSecondaryTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF555555"/>
                                        <Border x:Name="ButtonSecondaryPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="#FF555555"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Back Button -->
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Back Button:" 
                                               Classes="settings-field-label" 
                                               FontSize="14"
                                               Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ButtonBackTextBox" 
                                                 Grid.Column="0"
                                                 Height="28"
                                                 BorderThickness="1"
                                                 Padding="6,4"
                                                 FontSize="14"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Text="#FF404040"/>
                                        <Border x:Name="ButtonBackPreview"
                                                Grid.Column="1"
                                                Width="55"
                                                Height="28"
                                                Background="#FF404040"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Color Codes">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <settings:ColorCodesSettingsPanel Margin="20"/>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Templates">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <settings:ColorTemplatesSettingsPanel Margin="20"/>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Keywords">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <settings:KeywordGroupsSettingsPanel Margin="20"/>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Combat Text">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Subsequent Line Darkening" 
                                       FontSize="17" 
                                       FontWeight="SemiBold" 
                                       Classes="settings-field-label" 
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Controls how much darker subsequent lines (roll info, status effects) appear compared to the primary action line. Lower values = darker, higher values = brighter. Default: 0.8 (20% darker)" 
                                       Classes="settings-muted"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SubsequentLineDarkeningSlider"
                                        Grid.Column="0"
                                        Minimum="0.0"
                                        Maximum="1.0"
                                        Value="0.8"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"/>
                                <TextBox x:Name="SubsequentLineDarkeningTextBox"
                                         Grid.Column="1"
                                         Height="28"
                                         BorderThickness="1"
                                         Padding="6,4"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Text="0.8"/>
                                <TextBlock Grid.Column="2"
                                           Text="(0.0-1.0)"
                                           Classes="settings-muted"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="#FFE0E0E0" Margin="0,8,0,8"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Combat Log Side Padding"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Classes="settings-field-label"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Padding inside the left and right edges of the center combat log, as a percent of its width so it scales with your monitor. Your lines start this far from the left, enemy lines end this far from the right, like a chat thread. Default: 0 (edge to edge)"
                                       Classes="settings-muted"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="CombatLogSidePaddingSlider"
                                        Grid.Column="0"
                                        Minimum="0"
                                        Maximum="45"
                                        Value="0"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"/>
                                <TextBox x:Name="CombatLogSidePaddingTextBox"
                                         Grid.Column="1"
                                         Height="28"
                                         BorderThickness="1"
                                         Padding="6,4"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Text="0"/>
                                <TextBlock Grid.Column="2"
                                           Text="% (0-45)"
                                           Classes="settings-muted"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="#FFE0E0E0" Margin="0,8,0,8"/>
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="Animated text brightness (canvas)"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Classes="settings-field-label"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Bounds HSV Value (0–255 scale, V = max RGB / 255) for shimmering / undulating canvas text — hue and saturation stay the same; only Value is raised or capped. Higher minimum = brighter floor for dark letters; lower maximum = dimmer peaks."
                                       FontSize="12"
                                       Foreground="#FF666666"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Minimum:"
                                           VerticalAlignment="Center"
                                           Classes="settings-field-label"
                                           FontSize="14"
                                           Margin="0,0,14,10"/>
                                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,100,50">
                                    <Slider x:Name="AnimatedTextBrightnessMinSlider"
                                            Grid.Column="0"
                                            Minimum="0"
                                            Maximum="255"
                                            Value="0"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                    <TextBox x:Name="AnimatedTextBrightnessMinTextBox"
                                             Grid.Column="1"
                                             Height="28"
                                             BorderThickness="1"
                                             Padding="6,4"
                                             FontSize="14"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"
                                             Text="0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="0–255"
                                               FontSize="12"
                                               Foreground="#FF666666"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Maximum:"
                                           VerticalAlignment="Center"
                                           Classes="settings-field-label"
                                           FontSize="14"
                                           Margin="0,0,14,0"/>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,100,50">
                                    <Slider x:Name="AnimatedTextBrightnessMaxSlider"
                                            Grid.Column="0"
                                            Minimum="0"
                                            Maximum="255"
                                            Value="255"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>
                                    <TextBox x:Name="AnimatedTextBrightnessMaxTextBox"
                                             Grid.Column="1"
                                             Height="28"
                                             BorderThickness="1"
                                             Padding="6,4"
                                             FontSize="14"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"
                                             Text="255"/>
                                    <TextBlock Grid.Column="2"
                                               Text="0–255"
                                               FontSize="12"
                                               Foreground="#FF666666"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Narrative Video">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="20">
                    <TextBlock Text="Narrative video overlay"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Classes="settings-field-label"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Per-cell MP4 over the combat-log band (F5 toggles the feed; F7 narrative + dungeon required by default). Sliders apply live; Save persists to UIConfiguration.json."
                               Classes="settings-muted"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="180,*,80">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Opacity"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,10"/>
                        <Slider x:Name="NarrativeVideoOpacitySlider"
                                Grid.Row="0" Grid.Column="1"
                                Minimum="0" Maximum="1"
                                Value="0.45"
                                TickFrequency="0.05"
                                Margin="0,0,12,10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Peak cell opacity for bright glyphs (maxOpacity)."/>
                        <TextBox x:Name="NarrativeVideoOpacityTextBox"
                                 Grid.Row="0" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="0.45"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Blurry opacity"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,10"/>
                        <Slider x:Name="NarrativeVideoBlurryOpacitySlider"
                                Grid.Row="1" Grid.Column="1"
                                Minimum="0" Maximum="1"
                                Value="0.35"
                                TickFrequency="0.05"
                                Margin="0,0,12,10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Halo softness as a fraction of the source cell opacity (haloOpacityScale)."/>
                        <TextBox x:Name="NarrativeVideoBlurryOpacityTextBox"
                                 Grid.Row="1" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="0.35"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Video levels"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,0"/>
                        <Slider x:Name="NarrativeVideoLevelsSlider"
                                Grid.Row="2" Grid.Column="1"
                                Minimum="0" Maximum="8"
                                Value="1"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Halo blur extent in character cells around glyphs (haloCells). 0 = sharp cells only."/>
                        <TextBox x:Name="NarrativeVideoLevelsTextBox"
                                 Grid.Row="2" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Text="1"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Room Backdrop">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="20">
                    <TextBlock Text="Room backdrop"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Classes="settings-field-label"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="The room picture behind the center panel during a dungeon run. Filters apply in order saturation, contrast, brightness, blur; the result is then blended onto the base color. Changes apply live; Save persists to UIConfiguration.json."
                               Classes="settings-muted"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <CheckBox x:Name="RoomBackdropEnabledCheckBox"
                              Content="Show room backdrops"
                              IsChecked="True"/>

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="180,*,80">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Brightness"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,10"/>
                        <Slider x:Name="RoomBackdropBrightnessSlider"
                                Grid.Row="0" Grid.Column="1"
                                Minimum="0" Maximum="2"
                                Value="0.4"
                                TickFrequency="0.05"
                                Margin="0,0,12,10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Color multiplier. 0 = black, 1 = as painted, 2 = double. Default 0.4 keeps combat text readable."/>
                        <TextBox x:Name="RoomBackdropBrightnessTextBox"
                                 Grid.Row="0" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="0.4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Contrast"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,10"/>
                        <Slider x:Name="RoomBackdropContrastSlider"
                                Grid.Row="1" Grid.Column="1"
                                Minimum="0" Maximum="2"
                                Value="1"
                                TickFrequency="0.05"
                                Margin="0,0,12,10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Contrast around mid-grey. 0 = flat grey, 1 = as painted."/>
                        <TextBox x:Name="RoomBackdropContrastTextBox"
                                 Grid.Row="1" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="1"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Saturation"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,10"/>
                        <Slider x:Name="RoomBackdropSaturationSlider"
                                Grid.Row="2" Grid.Column="1"
                                Minimum="0" Maximum="2"
                                Value="1"
                                TickFrequency="0.05"
                                Margin="0,0,12,10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="0 = greyscale, 1 = as painted, 2 = vivid."/>
                        <TextBox x:Name="RoomBackdropSaturationTextBox"
                                 Grid.Row="2" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="1"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Blur"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,10"/>
                        <Slider x:Name="RoomBackdropBlurSlider"
                                Grid.Row="3" Grid.Column="1"
                                Minimum="0" Maximum="20"
                                Value="0"
                                TickFrequency="0.5"
                                Margin="0,0,12,10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Gaussian blur radius in pixels. 0 = sharp."/>
                        <TextBox x:Name="RoomBackdropBlurTextBox"
                                 Grid.Row="3" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="Opacity"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,0"/>
                        <Slider x:Name="RoomBackdropOpacitySlider"
                                Grid.Row="4" Grid.Column="1"
                                Minimum="0" Maximum="1"
                                Value="1"
                                TickFrequency="0.05"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Plate opacity over the base color. Lower values let the base color show through."/>
                        <TextBox x:Name="RoomBackdropOpacityTextBox"
                                 Grid.Row="4" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0"
                                 Text="1"/>
                    </Grid>

                    <Grid ColumnDefinitions="180,*,80" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Blend mode"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,10"/>
                        <ComboBox x:Name="RoomBackdropBlendModeComboBox"
                                  Grid.Row="0" Grid.Column="1"
                                  MinWidth="200"
                                  Margin="0,0,12,10"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="How the picture combines with the base color. Multiply / Color / Luminosity tint the room with a non-black base."/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Base color"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,0"/>
                        <TextBox x:Name="RoomBackdropBaseColorTextBox"
                                 Grid.Row="1" Grid.Column="1"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 Width="120"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"
                                 Text="#000000"
                                 ToolTip.Tip="Hex color under the picture (#RRGGBB)."/>
                        <Border x:Name="RoomBackdropBaseColorPreview"
                                Grid.Row="1" Grid.Column="2"
                                Width="40" Height="24"
                                BorderBrush="#FF808080"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                Background="#FF000000"/>
                    </Grid>

                    <CheckBox x:Name="RoomBackdropItemAsciiCheckBox"
                              Content="Ascii item icons (when Style is Ascii)"
                              IsChecked="False"
                              Margin="0,0,0,10"/>

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="180,*,80">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Style"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,10"/>
                        <ComboBox x:Name="RoomBackdropStyleComboBox"
                                  Grid.Row="0" Grid.Column="1"
                                  MinWidth="200"
                                  Margin="0,0,12,10"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Image draws the picture as painted. Ascii redraws it as glyphs on the text grid, one per cell, picked by brightness and colored by the picture."/>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Ascii image underlay"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,10"/>
                        <Slider x:Name="RoomBackdropAsciiImageUnderlaySlider"
                                Grid.Row="1" Grid.Column="1"
                                Minimum="0" Maximum="1"
                                Value="0.25"
                                TickFrequency="0.05"
                                Margin="0,0,12,10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Ascii style: opacity of the picture drawn under the glyphs. 0 = glyphs on black."/>
                        <TextBox x:Name="RoomBackdropAsciiImageUnderlayTextBox"
                                 Grid.Row="1" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="0.25"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Ascii cell fill"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,10"/>
                        <Slider x:Name="RoomBackdropAsciiBackgroundSlider"
                                Grid.Row="2" Grid.Column="1"
                                Minimum="0" Maximum="1"
                                Value="0.15"
                                TickFrequency="0.05"
                                Margin="0,0,12,10"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Ascii style: how much of each cell's color fills the cell behind its glyph. 0 = glyphs on black."/>
                        <TextBox x:Name="RoomBackdropAsciiBackgroundTextBox"
                                 Grid.Row="2" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="0.15"/>

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Ascii glyph gain"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,0"/>
                        <Slider x:Name="RoomBackdropAsciiGlyphGainSlider"
                                Grid.Row="3" Grid.Column="1"
                                Minimum="0" Maximum="4"
                                Value="1.6"
                                TickFrequency="0.05"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Ascii style: glyph color multiplier. Glyphs cover only part of a cell, so they read darker than the picture."/>
                        <TextBox x:Name="RoomBackdropAsciiGlyphGainTextBox"
                                 Grid.Row="3" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="1.6"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="Ascii density"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,0"/>
                        <Slider x:Name="RoomBackdropAsciiDensitySlider"
                                Grid.Row="4" Grid.Column="1"
                                Minimum="1" Maximum="4"
                                Value="2"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Ascii style: glyphs per text cell along each axis. 1 = one glyph per cell on the text grid; 2–4 = smaller glyphs for a finer picture."/>
                        <TextBox x:Name="RoomBackdropAsciiDensityTextBox"
                                 Grid.Row="4" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="2"/>

                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="Item ascii density"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,0"/>
                        <Slider x:Name="RoomBackdropItemAsciiDensitySlider"
                                Grid.Row="5" Grid.Column="1"
                                Minimum="1" Maximum="8"
                                Value="3"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Ascii style, item icons: glyphs per text cell along each axis. Higher = finer icon."/>
                        <TextBox x:Name="RoomBackdropItemAsciiDensityTextBox"
                                 Grid.Row="5" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="3"/>

                        <TextBlock Grid.Row="6" Grid.Column="0"
                                   Text="Item glyph brightness"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,0"/>
                        <Slider x:Name="RoomBackdropItemAsciiGlyphGainSlider"
                                Grid.Row="6" Grid.Column="1"
                                Minimum="0" Maximum="4"
                                Value="2.6"
                                TickFrequency="0.05"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Ascii style, item icons: glyph color multiplier."/>
                        <TextBox x:Name="RoomBackdropItemAsciiGlyphGainTextBox"
                                 Grid.Row="6" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="2.6"/>

                        <TextBlock Grid.Row="7" Grid.Column="0"
                                   Text="Item cell fill"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,0"/>
                        <Slider x:Name="RoomBackdropItemAsciiBackgroundSlider"
                                Grid.Row="7" Grid.Column="1"
                                Minimum="0" Maximum="1"
                                Value="0"
                                TickFrequency="0.01"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Ascii style, item icons: how much of each cell's color fills the cell behind its glyph."/>
                        <TextBox x:Name="RoomBackdropItemAsciiBackgroundTextBox"
                                 Grid.Row="7" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,10"
                                 Text="0"/>

                        <TextBlock Grid.Row="8" Grid.Column="0"
                                   Text="Item dark cutoff"
                                   VerticalAlignment="Center"
                                   Classes="settings-field-label"
                                   FontSize="14"
                                   Margin="0,0,12,0"/>
                        <Slider x:Name="RoomBackdropItemAsciiCutoffSlider"
                                Grid.Row="8" Grid.Column="1"
                                Minimum="0" Maximum="0.9"
                                Value="0.25"
                                TickFrequency="0.01"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Ascii style, item icons: cells darker than this share of the icon's brightness range stay blank, dropping the dark backdrop."/>
                        <TextBox x:Name="RoomBackdropItemAsciiCutoffTextBox"
                                 Grid.Row="8" Grid.Column="2"
                                 Height="28"
                                 BorderThickness="1"
                                 Padding="6,4"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Margin="0"
                                 Text="0.25"/>
                    </Grid>

                    <Button x:Name="RoomBackdropResetButton"
                            Content="Reset to defaults"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
