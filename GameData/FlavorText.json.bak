    "playerDefeated": [
      "You go down, and {enemy} doesn't slow to check the work.",
      "The last thing you register is {enemy} still standing.",
      "You hit the ground and {enemy}'s the only thing left moving.",
      "It ends fast — {enemy} wins, and you don't get a say in how.",
      "You're out before you register the last hit landed.",
      "{enemy} finishes it, and you're not in any shape to argue.",
      "The fight's over, and you're the one on the ground this time.",
      "You go still, and {enemy} doesn't stick around to gloat."
    ],
    "playerTaunt": [
      "\"You're slower than you think, {enemy}.\" {name} circles, watching.",
      "\"This isn't going the way you planned, is it, {enemy}?\" {name} says.",
      "\"You picked the wrong day for this, {enemy}.\" {name} keeps their guard up.",
      "\"I've had worse mornings than you, {enemy}.\" {name} mutters.",
      "\"You're going to want to reconsider this, {enemy}.\" {name} warns.",
      "\"Last chance to walk off, {enemy}.\" {name} doesn't lower their weapon.",
      "\"You're not the first to try this, {enemy}. Won't be the last either.\" {name} says flatly.",
      "\"I don't enjoy this part, {enemy}, but I'll finish it.\" {name} says.",
      "\"You're wasting both our time, {enemy}.\" {name} sighs.",
      "\"This doesn't have to go the way you think it does, {enemy}.\" {name} says, watching for an opening."
    ],
    "enemyTaunt": [
      "\"You won't walk out of here, {player}.\" {name} says, low.",
      "\"I've buried better than you, {player}.\" {name} growls.",
      "\"You're already tired, {player}. I can see it.\" {name} watches close.",
      "\"This ends however I decide it ends, {player}.\" {name} says.",
      "\"You shouldn't have come here, {player}.\" {name} warns.",
      "\"I don't need long for this, {player}.\" {name} says, unbothered.",
      "\"You're not leaving this the way you came, {player}.\" {name} says.",
      "\"I've heard better threats than yours, {player}.\" {name} says.",
      "\"This is going to hurt more than you're ready for, {player}.\" {name} says.",
      "\"You made a mistake coming here, {player}.\" {name} says quietly."
    ],
    "enemyTaunt_nativeFauna": [],
    "enemyTaunt_feralStock": [],
    "enemyTaunt_technoEcho": [],
    "playerTaunt_library": [
      "\"Shh! We're in a library!\" {name} whispers fiercely to {enemy}.",
      "\"Keep your voice down, {enemy}!\" {name} hisses in the quiet study.",
      "\"This sacred place demands respect, {enemy}!\" {name} murmurs among the ancient tomes.",
      "\"Silence! The books are watching, {enemy}!\" {name} whispers ominously."
    ],
    "enemyTaunt_library": [
      "\"Silence! This sacred place demands respect!\" {name} hisses at {player}.",
      "\"Quiet! The ancient knowledge must not be disturbed!\" {name} whispers menacingly.",
      "\"Hush! The spirits of the library will judge you, {player}!\" {name} intones softly.",
      "\"The books themselves will witness your defeat, {player}!\" {name} murmurs in the shadows."
    ],
    "playerTaunt_underwater": [
      "*Bubbles escape {name}'s mouth as they gesture threateningly at {enemy}.*",
      "*{name} makes aggressive hand signals, bubbles streaming upward.*",
      "*{name} points menacingly at {enemy}, their words lost in the depths.*",
      "*{name} shakes their fist, the gesture clear despite the watery silence.*"
    ],
    "enemyTaunt_underwater": [
      "*{name} makes aggressive gestures, bubbles streaming from their mouth.*",
      "*{name} points threateningly at {player}, their words lost in the watery depths.*",
      "*{name} shakes their weapon menacingly, bubbles rising from their movements.*",
      "*{name} makes a cutting motion across their throat, the threat clear despite the silence.*"
    ],
    "playerTaunt_lava": [
      "\"The heat won't save you, {enemy}!\" {name} shouts over the roaring flames.",
      "\"You'll burn before I do, {enemy}!\" {name} yells through the inferno.",
      "\"The fire only makes me stronger, {enemy}!\" {name} roars above the molten rock.",
      "\"I thrive in this heat, {enemy}!\" {name} bellows in the volcanic chamber."
    ],
    "enemyTaunt_lava": [
      "\"You'll burn before you defeat me, {player}!\" {name} roars through the inferno.",
      "\"The molten rock will claim you, {player}!\" {name} shouts over the crackling flames.",
      "\"This is my domain, {player}!\" {name} bellows in the volcanic heat.",
      "\"The fire itself will consume you, {player}!\" {name} roars above the lava flows."
    ],
    "playerTaunt_crypt": [
      "\"You belong here with the dead, {enemy}!\" {name} declares in the echoing tomb.",
      "\"The spirits will welcome you, {enemy}!\" {name} intones in the burial chamber.",
      "\"Your place is among the bones, {enemy}!\" {name} echoes through the crypt.",
      "\"The dead will claim you as their own, {enemy}!\" {name} proclaims in the tomb."
    ],
    "enemyTaunt_crypt": [
      "\"Join the others in eternal rest, {player}!\" {name} intones ominously.",
      "\"The crypt will be your final resting place, {player}!\" {name} echoes in the tomb.",
      "\"Your bones will join the others, {player}!\" {name} declares in the burial chamber.",
      "\"The dead welcome you, {player}!\" {name} intones in the echoing crypt."
    ],
    "playerTaunt_crystal": [
      "\"Your fate is crystal clear, {enemy}!\" {name} shouts, voice echoing off the gems.",
      "\"You'll shatter like glass, {enemy}!\" {name} calls through the crystalline chamber.",
      "\"The crystals themselves will witness your defeat, {enemy}!\" {name} proclaims.",
      "\"Your reflection shows your doom, {enemy}!\" {name} shouts in the gem-studded cave."
    ],
    "enemyTaunt_crystal": [
      "\"You'll shatter like glass, {player}!\" {name} bellows in the crystalline chamber.",
      "\"The gems will be your tomb, {player}!\" {name} echoes through the crystal cave.",
      "\"Your fate is written in the crystals, {player}!\" {name} intones ominously.",
      "\"The crystal formations will be your grave, {player}!\" {name} roars in the gem chamber."
    ],
    "playerTaunt_temple": [
      "\"The gods favor me, not you, {enemy}!\" {name} proclaims in the sacred hall.",
      "\"Divine justice will strike you down, {enemy}!\" {name} declares in the temple.",
      "\"The holy ground rejects you, {enemy}!\" {name} calls in the sanctuary.",
      "\"The gods themselves will judge you, {enemy}!\" {name} proclaims in the sacred space."
    ],
    "enemyTaunt_temple": [
      "\"Your blasphemy ends here, {player}!\" {name} thunders in the holy sanctuary.",
      "\"The gods will punish your sacrilege, {player}!\" {name} roars in the temple.",
      "\"This sacred ground will reject you, {player}!\" {name} bellows in the hall.",
      "\"Divine wrath will consume you, {player}!\" {name} thunders in the sanctuary."
    ],
    "playerTaunt_forest": [
      "\"You picked the wrong grove to die in, {enemy},\" {name} mutters, backing toward the trees.",
      "\"{enemy}, this wood's older than both of us — it won't remember you long.\" {name} grins.",
      "\"Every root here's heard better threats than yours, {enemy}.\" {name} plants their feet.",
      "\"{enemy}, the trees don't take sides. Lucky for me, I don't need them to.\" {name} says."
